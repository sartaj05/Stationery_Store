DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-long-random-secret-and-store-it-securely
DJANGO_ALLOWED_HOSTS=shop.example.com,www.shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com
DJANGO_USE_POSTGRES=True
POSTGRES_DB=delhi_stationery
POSTGRES_USER=delhi_stationery_app
POSTGRES_PASSWORD=replace-with-managed-secret
POSTGRES_HOST=postgres.example.internal
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60
DJANGO_MEDIA_ROOT=/srv/delhi-stationery/media
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_TRUST_X_FORWARDED_PROTO=True
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USER=replace-with-mail-user
DJANGO_EMAIL_PASSWORD=replace-with-managed-secret
DJANGO_DEFAULT_FROM_EMAIL=Delhi Stationery <orders@example.com>
